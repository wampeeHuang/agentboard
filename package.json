{
  "name": "agentboard",
  "version": "1.0.0",
  "description": "Filesystem-as-registry toolchain control plane for AI agents. Auto-discovers tools from manifest.json, checks port status, one-click start/stop.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"lib/__tests__/*.test.js\"",
    "coverage": "c8 --include=\"lib/**/*.js\" --include=\"server.js\" --exclude=\"lib/__tests__/**\" node --test \"lib/__tests__/*.test.js\""
  },
  "keywords": [
    "ai-agent",
    "tool-dashboard",
    "control-plane",
    "toolchain",
    "homelab"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
