# Agentboard environment template. Copy values into your shell; this file is not auto-loaded.
# Data root: tools / apps / tips / principles / state / config / _runtime / archive / skills
# Default: ~/.agentboard (Windows: %USERPROFILE%\.agentboard)
# AGENTBOARD_HOME=%USERPROFILE%\.agentboard
PORT=3099

# Optional overrides
# AGENTBOARD_TOOLS_DIR=%USERPROFILE%\.agentboard\tools
# AGENTBOARD_APPS_REGISTRY=%USERPROFILE%\.agentboard\apps
# AGENTBOARD_TIPS_DIR=%USERPROFILE%\.agentboard\tips
# AGENTBOARD_PRINCIPLES_DIR=%USERPROFILE%\.agentboard\principles
# AGENTBOARD_STATE_DIR=%USERPROFILE%\.agentboard\state
# AGENTBOARD_RUNTIME_DIR=%USERPROFILE%\.agentboard\_runtime
# AGENTBOARD_CONFIG_DIR=%USERPROFILE%\.agentboard\config
# AGENTBOARD_ARCHIVE_DIR=%USERPROFILE%\.agentboard\archive
# AGENTBOARD_LOCAL_SKILLS_DIR=%USERPROFILE%\.agentboard\skills
# AGENTBOARD_SKILLS_DIR=%USERPROFILE%\.claude\skills

# Connector secrets must stay in the service environment / OS keychain, never in config files.
# Example names (not values):
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=
