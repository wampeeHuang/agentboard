{
  "template": "DTCG-style",
  "version": "1.0",
  "description": "agentboard 工具架前端设计 token 契约源。:root 镜像此文件，CSS 用 var() 消费。单一真相源。",
  "tokens": {
    "color": {
      "ink": { "$type": "color", "value": "#002FA7", "role": "brand" },
      "ink-rgb": { "$type": "color", "value": "0,47,167", "role": "brand-rgb" },
      "paper": { "$type": "color", "value": "#FAFAF8", "role": "surface-bg" },
      "paper-tint": { "$type": "color", "value": "#F2F2F0", "role": "surface-alt" },
      "border": { "$type": "color", "value": "#E0E0DC", "role": "border-default" },
      "text": { "$type": "color", "value": "#0A0A0A", "role": "text-primary" },
      "text-secondary": { "$type": "color", "value": "#555555", "role": "text-secondary" },
      "text-muted": { "$type": "color", "value": "#999999", "role": "text-muted" },
      "text-inverse": { "$type": "color", "value": "#FFFFFF", "role": "text-on-brand" },
      "action-go": { "$type": "color", "value": "#2D2D2D", "role": "button-go" },
      "action-go-hover": { "$type": "color", "value": "#1A1A1A", "role": "button-go-hover" },
      "action-danger": { "$type": "color", "value": "#C0392B", "role": "button-stop" },
      "action-danger-hover": { "$type": "color", "value": "#C0392B", "role": "button-stop-hover" },
      "action-success-hover": { "$type": "color", "value": "#157A34", "role": "button-open-hover" },
      "status-on": { "$type": "color", "value": "#1A8A3F", "role": "state-running" },
      "status-off": { "$type": "color", "value": "#BBBBBB", "role": "state-stopped" },
      "status-starting": { "$type": "color", "value": "#3B82F6", "role": "state-starting" },
      "status-halting": { "$type": "color", "value": "#D97706", "role": "state-halting" },
      "status-error": { "$type": "color", "value": "#C0392B", "role": "state-start_failed/broken" },
      "status-warn": { "$type": "color", "value": "#C7902B", "role": "state-incomplete" },
      "status-orphan": { "$type": "color", "value": "#8B5CF6", "role": "state-orphan" },
      "status-stale": { "$type": "color", "value": "#8B5A2B", "role": "state-stale_path" },
      "status-disabled": { "$type": "color", "value": "#CCCCCC", "role": "state-disabled" },
      "success": { "$type": "color", "value": "#059669", "role": "semantic-success" },
      "accent-purple": { "$type": "color", "value": "#8B5CF6", "role": "type-api/command" },
      "accent-orange": { "$type": "color", "value": "#D97706", "role": "type-cli/folder" },
      "accent-blue": { "$type": "color", "value": "#3B82F6", "role": "type-web" },
      "lang-python": { "$type": "color", "value": "#3776AB", "role": "runtime-badge" },
      "lang-node": { "$type": "color", "value": "#27AE60", "role": "runtime-badge" },
      "lang-go": { "$type": "color", "value": "#00ADD8", "role": "runtime-badge" },
      "lang-rust": { "$type": "color", "value": "#DEA584", "role": "runtime-badge" },
      "lang-cpp": { "$type": "color", "value": "#00599C", "role": "runtime-badge" },
      "lang-csharp": { "$type": "color", "value": "#68217A", "role": "runtime-badge" },
      "lang-shell": { "$type": "color", "value": "#6B7280", "role": "runtime-badge" },
      "lang-other": { "$type": "color", "value": "#8B5CF6", "role": "runtime-badge" },
      "gc-success": { "$type": "color", "value": "#27AE60", "role": "cron-substate" },
      "gc-error": { "$type": "color", "value": "#E67E22", "role": "cron-substate" },
      "gc-fatal": { "$type": "color", "value": "#C0392B", "role": "cron-substate" }
    },
    "radius": {
      "sm": { "$type": "dimension", "value": "4px", "role": "corner-small" },
      "md": { "$type": "dimension", "value": "8px", "role": "corner-card" },
      "pill": { "$type": "dimension", "value": "999px", "role": "corner-pill" }
    },
    "shadow": {
      "border": { "$type": "shadow", "value": "0 0 0 1px rgba(0,0,0,0.08)", "role": "hairline" },
      "card": { "$type": "shadow", "value": "0 1px 3px rgba(0,0,0,0.06)", "role": "elevation-subtle" },
      "card-hover": { "$type": "shadow", "value": "0 2px 8px rgba(0,0,0,0.1)", "role": "elevation-hover" }
    }
  }
}
